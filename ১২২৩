<!DOCTYPE html>
<html lang="bn">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>High-Voltage Surge & Appliance Explosion Simulator</title>
    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }
        body {
            background-color: #0f172a;
            color: #f8fafc;
            display: flex;
            flex-direction: column;
            align-items: center;
            min-height: 100vh;
            padding: 20px;
        }
        h1 {
            margin-bottom: 5px;
            color: #ef4444;
            font-size: 24px;
            text-align: center;
        }
        p.subtitle {
            color: #94a3b8;
            margin-bottom: 20px;
            font-size: 14px;
            text-align: center;
        }
        .container {
            width: 100%;
            max-width: 900px;
            display: flex;
            flex-direction: column;
            gap: 20px;
        }
        /* Controls Section */
        .panel {
            background: #1e293b;
            padding: 20px;
            border-radius: 12px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.5);
            border: 1px solid #334155;
        }
        .voltage-control {
            display: flex;
            flex-direction: column;
            gap: 15px;
        }
        .slider-group {
            display: flex;
            align-items: center;
            gap: 15px;
        }
        input[type=range] {
            flex: 1;
            height: 10px;
            border-radius: 5px;
            accent-color: #ef4444;
            cursor: pointer;
        }
        .voltage-display {
            font-size: 28px;
            font-weight: bold;
            color: #38bdf8;
            min-width: 90px;
            text-align: right;
        }
        .btn-group {
            display: flex;
            gap: 10px;
            margin-top: 10px;
        }
        button {
            padding: 10px 18px;
            border: none;
            border-radius: 6px;
            font-weight: bold;
            cursor: pointer;
            transition: 0.2s;
        }
        .btn-surge { background: #ef4444; color: white; }
        .btn-surge:hover { background: #dc2626; }
        .btn-reset { background: #3b82f6; color: white; }
        .btn-reset:hover { background: #2563eb; }
        
        /* Status Banner */
        .status-box {
            padding: 12px;
            border-radius: 6px;
            font-weight: bold;
            text-align: center;
            background: #064e3b;
            color: #6ee7b7;
            margin-top: 10px;
        }
        .status-box.warning { background: #78350f; color: #fde047; }
        .status-box.danger { background: #7f1d1d; color: #fca5a5; }
        
        /* Grid Layout for Appliances */
        .grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 15px;
        }
        .card {
            background: #1e293b;
            border: 2px solid #334155;
            border-radius: 10px;
            padding: 15px;
            display: flex;
            flex-direction: column;
            align-items: center;
            position: relative;
            overflow: hidden;
            transition: 0.3s;
        }
        .card.destroyed {
            border-color: #ef4444;
            background: #18181b;
            animation: shake 0.5s ease-in-out;
        }
        .appliance-icon {
            font-size: 50px;
            margin-bottom: 10px;
            transition: 0.2s;
        }
        .status-badge {
            font-size: 12px;
            padding: 3px 8px;
            border-radius: 4px;
            background: #22c55e;
            color: black;
            font-weight: bold;
            margin-top: 8px;
        }
        .card.destroyed .status-badge {
            background: #ef4444;
            color: white;
        }
        
        /* Visual Smoke / Fire FX */
        .smoke {
            position: absolute;
            top: 0; left: 0; right: 0; bottom: 0;
            background: rgba(0,0,0,0.85);
            display: flex;
            justify-content: center;
            align-items: center;
            color: #ef4444;
            font-weight: bold;
            font-size: 18px;
            opacity: 0;
            pointer-events: none;
            transition: opacity 0.3s;
        }
        .card.destroyed .smoke {
            opacity: 1;
        }

        @keyframes shake {
            0%, 100% { transform: translateX(0); }
            20% { transform: translateX(-8px) rotate(-2deg); }
            40% { transform: translateX(8px) rotate(2deg); }
            60% { transform: translateX(-5px); }
            80% { transform: translateX(5px); }
        }
    </style>
</head>
<body>

    <h1>⚡ High-Voltage Household Surge Simulator</h1>
    <p class="subtitle">ভোল্টেজ বাড়িয়ে দেখুন কোন ডোমেইন ডিভাইস কত ভোল্টেজে নষ্ট হয়!</p>

    <div class="container">
        <!-- Main Control Panel -->
        <div class="panel">
            <div class="voltage-control">
                <label>Main Line Voltage (AC):</label>
                <div class="slider-group">
                    <input type="range" id="voltageSlider" min="150" max="450" value="220" oninput="updateVoltage(this.value)">
                    <div class="voltage-display" id="voltageVal">220V</div>
                </div>
                <div class="btn-group">
                    <button class="btn-surge" onclick="triggerLightning()">⚡ High Surge (400V Spike)</button>
                    <button class="btn-reset" onclick="resetCircuit()">🔄 Reset Circuit / Breaker</button>
                </div>
                <div id="statusBox" class="status-box">বিদ্যুৎ প্রবাহ স্বাভাবিক (Normal Operation)</div>
            </div>
        </div>

        <!-- Devices Grid -->
        <div class="grid">
            <!-- LED Bulb -->
            <div class="card" id="dev-bulb">
                <div class="appliance-icon" id="icon-bulb">💡</div>
                <h3>LED Bulb</h3>
                <small style="color: #94a3b8">Max Limit: 260V</small>
                <div class="status-badge" id="badge-bulb">চালু (OK)</div>
                <div class="smoke">💥 BLASTED!</div>
            </div>

            <!-- Smart TV -->
            <div class="card" id="dev-tv">
                <div class="appliance-icon" id="icon-tv">📺</div>
                <h3>Smart TV</h3>
                <small style="color: #94a3b8">Max Limit: 280V</small>
                <div class="status-badge" id="badge-tv">চালু (OK)</div>
                <div class="smoke">🔥 SCREEN GLITCHED!</div>
            </div>

            <!-- Refrigerator -->
            <div class="card" id="dev-fridge">
                <div class="appliance-icon" id="icon-fridge">🧊</div>
                <h3>Refrigerator</h3>
                <small style="color: #94a3b8">Max Limit: 310V</small>
                <div class="status-badge" id="badge-fridge">চালু (OK)</div>
                <div class="smoke">⚡ COMPRESSOR SHORT!</div>
            </div>

            <!-- Desktop PC -->
            <div class="card" id="dev-pc">
                <div class="appliance-icon" id="icon-pc">🖥️</div>
                <h3>Desktop PC</h3>
                <small style="color: #94a3b8">Max Limit: 340V</small>
                <div class="status-badge" id="badge-pc">চালু (OK)</div>
                <div class="smoke">🔥 PSU BLOWN!</div>
            </div>
        </div>
    </div>

    <script>
        const devices = {
            bulb: { limit: 260, destroyed: false, name: "LED Bulb", icon: "💡", blownIcon: "💥" },
            tv: { limit: 280, destroyed: false, name: "Smart TV", icon: "📺", blownIcon: "💨" },
            fridge: { limit: 310, destroyed: false, name: "Refrigerator", icon: "🧊", blownIcon: "🔥" },
            pc: { limit: 340, destroyed: false, name: "Desktop PC", icon: "🖥️", blownIcon: "☠️" }
        };

        function updateVoltage(val) {
            document.getElementById('voltageVal').innerText = val + "V";
            const statusBox = document.getElementById('statusBox');

            if (val > 350) {
                statusBox.innerText = "⚠️ DANGER: চরম হাই-ভোল্টেজ স্পাইক!";
                statusBox.className = "status-box danger";
            } else if (val > 250) {
                statusBox.innerText = "⚠️ WARNING: ওভারভোল্টেজ ধরা পড়েছে!";
                statusBox.className = "status-box warning";
            } else {
                statusBox.innerText = "বিদ্যুৎ প্রবাহ স্বাভাবিক (Normal Operation)";
                statusBox.className = "status-box";
            }

            checkDamage(val);
        }

        function checkDamage(voltage) {
            for (let key in devices) {
                let dev = devices[key];
                if (voltage >= dev.limit && !dev.destroyed) {
                    dev.destroyed = true;
                    let card = document.getElementById(`dev-${key}`);
                    let icon = document.getElementById(`icon-${key}`);
                    let badge = document.getElementById(`badge-${key}`);

                    card.classList.add('destroyed');
                    icon.innerText = dev.blownIcon;
                    badge.innerText = "নষ্ট (DAMAGED)";
                }
            }
        }

        function triggerLightning() {
            let slider = document.getElementById('voltageSlider');
            slider.value = 420;
            updateVoltage(420);
        }

        function resetCircuit() {
            let slider = document.getElementById('voltageSlider');
            slider.value = 220;
            
            for (let key in devices) {
                let dev = devices[key];
                dev.destroyed = false;
                let card = document.getElementById(`dev-${key}`);
                let icon = document.getElementById(`icon-${key}`);
                let badge = document.getElementById(`badge-${key}`);

                card.classList.remove('destroyed');
                icon.innerText = dev.icon;
                badge.innerText = "চালু (OK)";
            }

            updateVoltage(220);
        }
    </script>
</body>
</html>
